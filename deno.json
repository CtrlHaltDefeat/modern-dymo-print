{
	"name": "@ctrlhaltdefeat/modern-dymo-print",
	"version": "1.0.3",
	"exports": "./src/index.ts",
	"publish": {
		"include": [
			"./src/**/*.ts",
			"./deno.json",
			"./README.md",
			"./LICENSE"
		]
	},
	"tasks": {
		"dev": "deno run --allow-all ./debug/serve.ts"
	},
	"imports": {
		"@/": "./src/",
		"@std/assert": "jsr:@std/assert@1.0.16",
		"@std/testing/mock": "jsr:@std/testing@1.0.16/mock",
		"happy-dom": "npm:happy-dom@20.0.11",
		"@happy-dom/global-registrator": "npm:@happy-dom/global-registrator@20.0.11"
	},
	"compilerOptions": {
		"lib": [
			"dom",
			"dom.iterable",
			"esnext",
			"deno.ns"
		]
	},
	"fmt": {
		"useTabs": true,
		"exclude": ["dymo.connect.framework.js"]
	},
	"lint": {
		"exclude": ["dymo.connect.framework.js"]
	}
}
